{
  "name": "setup-mq",
  "description": "This GitHub Action will setup mq in your GitHub Actions workflow",
  "version": "1.1.7",
  "author": "harehare",
  "type": "module",
  "private": true,
  "homepage": "https://mqlang.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harehare/setup-mq.git"
  },
  "bugs": {
    "url": "https://github.com/harehare/setup-mq/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format:write": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "pnpm run package --watch",
    "test": "vitest --run",
    "lint": "oxlint src",
    "bundle": "pnpm test && pnpm run package",
    "preversion": "pnpm run bundle"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "make-coverage-badge": "^1.2.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "rollup": "^4.67.5",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
